# ── Frontend: point the WebUI at the Play proxy ──────────────────────
# Empty (or unset) = offline demo backend with mock data.
VITE_PLAY_PROXY=http://127.0.0.1:8080

# ── Play proxy server (npm run dev:server / npm run server) ───────────
# Port the JSON API + APK streaming listens on.
PLAY_PORT=8080
# Anonymous token dispenser(s), comma-separated. Default is the dispenser
# the Android app ships with (https://auroraoss.com/api/auth).
DISPENSER_URL=https://auroraoss.com/api/auth
# Exodus API key. Default is the key shipped in the open-source Android
# app build; set your own from https://reports.exodus-privacy.eu.org.
EXODUS_API_KEY=
# Where server-side sessions persist (JSON file).
DATA_DIR=
# CORS origin for the API (default *).
CORS_ORIGIN=*
